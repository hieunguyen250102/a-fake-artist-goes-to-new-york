# Copy to server/.env for local runs; on Render set these in the dashboard.
# Leave every mail setting empty locally and the login code is printed to the
# server console (and shown under the code box) instead of being mailed.
# On Render's free plan SMTP is blocked — use MAIL_RELAY_URL (Vercel) or BREVO_API_KEY there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hoạ Sĩ Dởm <you@gmail.com>"
BREVO_API_KEY=
# Only these emails may create tables (comma-separated). Empty = anyone who logs in.
HOST_EMAILS=you@gmail.com
SESSION_SECRET=
